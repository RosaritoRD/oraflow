# Despliegue automático de Oraflow (scripts/autodeploy/run.mjs).
# Instalar: cp scripts/autodeploy/oraflow-autodeploy.{service,timer} /etc/systemd/system/
#           systemctl daemon-reload && systemctl enable --now oraflow-autodeploy.timer
[Unit]
Description=Oraflow — despliega cada commit nuevo del panel
After=network-online.target docker.service

[Service]
Type=oneshot
WorkingDirectory=/ruta/a/oraflow
Environment=HOME=/root
ExecStart=/usr/bin/node /ruta/a/oraflow/scripts/autodeploy/run.mjs
StandardOutput=append:/var/log/oraflow-autodeploy.log
StandardError=append:/var/log/oraflow-autodeploy.log
TimeoutStartSec=45min
