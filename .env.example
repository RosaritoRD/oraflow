# Oraflow — example configuration.
# Copy this file to .env and replace every YOUR_..._HERE with your real value.
# NEVER commit your .env to GitHub (it's already in .gitignore).
# CONTENT_LANGUAGE=es: the pipeline is tuned for Spanish-language channels.

NODE_ENV=production
PORT=3456
LOG_LEVEL=info
CHANNEL_NAME=Your channel
DEFAULT_AUTHOR=Your channel
TARGET_AUDIENCE=Hispanic Christians in the United States, aged 40-55, who start or end the day with a short prayer in Spanish
YOUTUBE_REGION=US
YOUTUBE_API_KEY=YOUR_YOUTUBE_API_KEY_HERE
DEFAULT_PRIVACY_STATUS=private
MAX_CONCURRENT_JOBS=1
ENABLE_ANALYTICS=true
ANALYTICS_DB_PATH=./data/analytics.db
ANONYMOUS_TELEMETRY_ENABLED=false
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY_HERE
ELEVENLABS_API_KEY=YOUR_ELEVENLABS_API_KEY_HERE
ELEVENLABS_VOICE_ID=YOUR_ELEVENLABS_VOICE_ID_HERE
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
VIDEO_PROVIDER=slideshow
VIDEO_GENERATION_MODE=hybrid
VIDEO_MAX_GENERATED_SECONDS=60
DEFAULT_VIDEO_LENGTH=5-6 minutes
YOUTUBE_RELEVANCE_LANGUAGE=es
CONTENT_LANGUAGE=es
CHANNEL_THEME=prayer
BACKGROUNDS_DIR=/app/data/assets/backgrounds
BACKGROUND_MUSIC_DIR=/app/data/assets/music
BACKGROUND_MUSIC_DB=-14
STORYBOARD_PIPELINE=on
VOICE_SPEED=0.88
VOICE_SENTENCE_PAUSE_MS=320
VOICE_PARAGRAPH_PAUSE_MS=750
BURN_CAPTIONS=on
RENDER_CONCURRENCY=2
PEXELS_API_KEY=YOUR_PEXELS_API_KEY_HERE
VISUAL_PACE=calm
PREFER_LANDSCAPES=on
VISUAL_STYLE=Calm prayer channel: sunrise skies, mountains, sea, forests, fields, rivers, light through windows, candles, open Bible, quiet churches and roads. People rarely, distant or from behind, never faces close-up, never couples or romance.
VISUAL_SHOT_SECONDS=15
DESCRIPTION_INTRO=Text that goes at the start of every description.
DESCRIPTION_FOOTER=Text that goes at the end of every description (links, subscribe, socials).
THUMBNAIL_STYLE=oracion
THUMBNAIL_DATE=on
CHANNEL_TIMEZONE=America/New_York
TITLE_DATE=off
ONLY_NATURE=on
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
THUMBNAIL_AI=off
IMAGE_MODEL=gpt-image-2
IMAGE_QUALITY=medium
TZ=America/New_York
DAILY_PUBLISH_TIME=04:00
AI_TEXT_PROVIDER=openrouter
VOICE_STABILITY=0.45
VOICE_SIMILARITY=0.85
VOICE_STYLE=0.30
SHORT_SHOT_SECONDS=15
BACKGROUND_MUSIC_DB_LONG=-11
BACKGROUND_MUSIC_DB_SHORT_LOUD=-11
SHORT_MUSIC_LOUD_PCT=40
FONDO_PRINCIPAL_PCT=80
ELEVENLABS_VOICE_IDS=YOUR_ELEVENLABS_VOICE_IDS_HERE
FACEBOOK_PAGE_ID=YOUR_FACEBOOK_PAGE_ID_HERE
FACEBOOK_PAGE_TOKEN=YOUR_FACEBOOK_PAGE_TOKEN_HERE
INSTAGRAM_TOKEN=YOUR_INSTAGRAM_TOKEN_HERE
LOCAL_LLM_URL=YOUR_LOCAL_LLM_URL_HERE
LOCAL_LLM_MODEL=qwen3:8b
ELEVENLABS_VOICE_PRINCIPAL=YOUR_ELEVENLABS_VOICE_PRINCIPAL_HERE
ELEVENLABS_VOICE_MUJER=YOUR_ELEVENLABS_VOICE_MUJER_HERE
FFMPEG_REMOTO_URL=YOUR_FFMPEG_REMOTO_URL_HERE
LOCAL_VOZ_URL=YOUR_LOCAL_VOZ_URL_HERE

# --- Optional ---
# Cheaper voice model for Shorts only (~half the credits). It may sound less
# natural: test it and check retention before locking it in.
# ELEVENLABS_TTS_MODEL_SHORT=eleven_flash_v2_5
# ELEVENLABS_SPEED_SHORT=1.08
# Second voice for some nights (voice calendar).
# ELEVENLABS_VOICE_SECUNDARIA=YOUR_ELEVENLABS_VOICE_SECUNDARIA_HERE
