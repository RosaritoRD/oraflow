# Oraflow — configuración de ejemplo.
# Copia este archivo a .env y cambia cada AQUI_VA_... por tu valor real.
# NUNCA subas tu .env a GitHub (ya está en .gitignore).

NODE_ENV=production
PORT=3456
LOG_LEVEL=info
CHANNEL_NAME=Tu canal
DEFAULT_AUTHOR=Oración de Hoy
TARGET_AUDIENCE=Hispanos cristianos en Estados Unidos, 40-55 años, que empiezan o cierran el día con una oración corta en español
YOUTUBE_REGION=US
YOUTUBE_API_KEY=AQUI_VA_TU_YOUTUBE_API_KEY
DEFAULT_PRIVACY_STATUS=private
MAX_CONCURRENT_JOBS=1
ENABLE_ANALYTICS=true
ANALYTICS_DB_PATH=./data/analytics.db
ANONYMOUS_TELEMETRY_ENABLED=false
OPENROUTER_API_KEY=AQUI_VA_TU_OPENROUTER_API_KEY
ELEVENLABS_API_KEY=AQUI_VA_TU_ELEVENLABS_API_KEY
ELEVENLABS_VOICE_ID=AQUI_VA_TU_ELEVENLABS_VOICE_ID
ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
GEMINI_API_KEY=AQUI_VA_TU_GEMINI_API_KEY
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
VIDEO_PROVIDER=slideshow
VIDEO_GENERATION_MODE=hybrid
VIDEO_MAX_GENERATED_SECONDS=60
DEFAULT_VIDEO_LENGTH=5-6 minutes
YOUTUBE_RELEVANCE_LANGUAGE=es
CONTENT_LANGUAGE=es
CHANNEL_THEME=prayer
BACKGROUNDS_DIR=/app/data/assets/backgrounds
BACKGROUND_MUSIC_DIR=/app/data/assets/music
BACKGROUND_MUSIC_DB=-14
STORYBOARD_PIPELINE=on
VOICE_SPEED=0.88
VOICE_SENTENCE_PAUSE_MS=320
VOICE_PARAGRAPH_PAUSE_MS=750
BURN_CAPTIONS=on
RENDER_CONCURRENCY=2
PEXELS_API_KEY=AQUI_VA_TU_PEXELS_API_KEY
VISUAL_PACE=calm
PREFER_LANDSCAPES=on
VISUAL_STYLE=Calm prayer channel: sunrise skies, mountains, sea, forests, fields, rivers, light through windows, candles, open Bible, quiet churches and roads. People rarely, distant or from behind, never faces close-up, never couples or romance.
VISUAL_SHOT_SECONDS=15
DESCRIPTION_INTRO=Texto que va al principio de cada descripción.
DESCRIPTION_FOOTER=Texto que va al final de cada descripción (enlaces, suscripción, redes).
THUMBNAIL_STYLE=oracion
THUMBNAIL_DATE=on
CHANNEL_TIMEZONE=America/New_York
TITLE_DATE=off
ONLY_NATURE=on
OPENAI_API_KEY=AQUI_VA_TU_OPENAI_API_KEY
THUMBNAIL_AI=off
IMAGE_MODEL=gpt-image-2
IMAGE_QUALITY=medium
TZ=America/New_York
DAILY_PUBLISH_TIME=04:00
AI_TEXT_PROVIDER=openrouter
VOICE_STABILITY=0.45
VOICE_SIMILARITY=0.85
VOICE_STYLE=0.30
SHORT_SHOT_SECONDS=15
BACKGROUND_MUSIC_DB_LONG=-11
BACKGROUND_MUSIC_DB_SHORT_LOUD=-11
SHORT_MUSIC_LOUD_PCT=40
FONDO_PRINCIPAL_PCT=80
ELEVENLABS_VOICE_IDS=AQUI_VA_TU_ELEVENLABS_VOICE_IDS
FACEBOOK_PAGE_ID=AQUI_VA_TU_FACEBOOK_PAGE_ID
FACEBOOK_PAGE_TOKEN=AQUI_VA_TU_FACEBOOK_PAGE_TOKEN
INSTAGRAM_TOKEN=AQUI_VA_TU_INSTAGRAM_TOKEN
LOCAL_LLM_URL=AQUI_VA_TU_LOCAL_LLM_URL
LOCAL_LLM_MODEL=qwen3:8b
ELEVENLABS_VOICE_PRINCIPAL=AQUI_VA_TU_ELEVENLABS_VOICE_PRINCIPAL
ELEVENLABS_VOICE_MUJER=AQUI_VA_TU_ELEVENLABS_VOICE_MUJER
FFMPEG_REMOTO_URL=AQUI_VA_TU_FFMPEG_REMOTO_URL
LOCAL_VOZ_URL=AQUI_VA_TU_LOCAL_VOZ_URL

# --- Opcionales ---
# Modelo de voz más barato solo para Shorts (~mitad de créditos). Puede sonar menos
# natural: pruébalo y mira la retención antes de dejarlo fijo.
# ELEVENLABS_TTS_MODEL_SHORT=eleven_flash_v2_5
# ELEVENLABS_SPEED_SHORT=1.08
# Segunda voz para algunas noches (calendario de voces).
# ELEVENLABS_VOICE_SECUNDARIA=AQUI_VA_TU_ELEVENLABS_VOICE_SECUNDARIA
